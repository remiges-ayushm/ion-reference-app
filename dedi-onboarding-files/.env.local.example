# Copy this file to .env.local and fill in real values.
# Taskfile.yaml (the `sign` task) loads DEDI_PUBLIC_KEY / DEDI_PRIVATE_KEY
# from dedi-onboarding-files/.env.local automatically before invoking
# dedi-file-signer.

# Ed25519 public key, padded standard Base64 (decodes to 32 bytes).
DEDI_PUBLIC_KEY=

# Ed25519 private key, padded standard Base64 (decodes to a 32-byte seed or a
# 64-byte key). Must correspond to DEDI_PUBLIC_KEY above.
DEDI_PRIVATE_KEY=
