server {
    listen 80 default_server;
    server_name ${DEDI_DOMAIN} ${DEDI_DOMAIN_WWW};

    root /usr/share/nginx/html;

    # DeDi discovery files (index.json, registry files, catalog files) are
    # fetched cross-origin by other network participants — allow it.
    add_header Access-Control-Allow-Origin "*" always;

    location /bpp/receiver/ {
        proxy_pass https://${ONIX_BPP_HOST}/bpp/receiver/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${ONIX_BPP_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/ {
        proxy_pass https://${BPP_HOST}/api/v1/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BPP_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/webhook/ {
        proxy_pass https://${BPP_HOST}/api/webhook/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BPP_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
}

# bap_domain is a hub, same pattern as the block above for bpp — everything
# lives behind this one domain: the validated receiver path proxies to
# onix-bap, everything else (dashboard API, webhook callbacks) proxies
# straight to bap.
server {
    listen 80;
    server_name ${BAP_DOMAIN};

    location /bap/receiver/ {
        proxy_pass https://${ONIX_BAP_HOST}/bap/receiver/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${ONIX_BAP_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass https://${BAP_HOST};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BAP_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
